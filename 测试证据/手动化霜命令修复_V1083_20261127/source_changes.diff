+static unsigned char PSC316ManualAllowed(uint8_t unit,uint8_t comp,int16_t value)
+{
+    uint8_t k=unit-1;
+    if(unit<1 || unit>4 || unit>=ModuleNumSet || comp>1 || HandDebug || ModUrgencyStop ||
+       UnitCommErr[unit] || !PSC316SetValid[k] || !PSC316StatusValid[k] ||
+       !PSC316UnitLastRespTick[k] || Systick_1ms-PSC316UnitLastRespTick[k]>=3000U ||
+       !PSC316ManualStatusTick[k] || Systick_1ms-PSC316ManualStatusTick[k]>=5000U ||
+       UserWorkModeSetTEMP!=MODE_HEAT)return 0;
+    if(value==2)return (UnitReadStatus[unit].CompStatus[0]==4 ||
+                       UnitReadStatus[unit].CompStatus[1]==4) ? 1:0;
+    if(value!=1 || SysStep!=2 || !Parameter[CompUse+2*k+comp] ||
+       PSC316SetMirror[k][2] || PSC316SetMirror[k][3+comp])return 0;
+    return UnitReadStatus[unit].CompStatus[comp]==3 ? 1:0;
+}
+unsigned char PSC316ManualDefrostCanWrite(unsigned short addr,int16_t value)
+{
+    uint8_t n;
+    if(addr<PSC316_MANUAL_DEFROST_BASE || addr>=PSC316_MANUAL_DEFROST_END)return 0;
+    if(value==0)return 1;
+    n=(uint8_t)(addr-PSC316_MANUAL_DEFROST_BASE);
+    return PSC316ManualAllowed(n/2+1,n%2,value);
+}
+static void PSC316ManualDefrostTask(void)
+{
+    uint8_t k,c,j;int16_t command;
+    for(k=0;k<4;k++)for(c=0;c<2;c++)
+    {
+        command=Parameter[PSC316_MANUAL_DEFROST_BASE+2*k+c];
+        Parameter[PSC316_MANUAL_DEFROST_BASE+2*k+c]=0;
+        if(command && PSC316ManualAllowed(k+1,c,command))
+        {
+            PSC316ManualGeneration[k]++;
+            if(command==1)
+            {PSC316ManualPending[k][c]=1;PSC316ManualTick[k][c]=Systick_1ms;}
+            else for(j=0;j<2;j++)
+            {
+                /* An exit word means the active GROUP, including both
+                   healthy participants. Never manufacture an idle request. */
+                if(UnitReadStatus[k+1].CompStatus[j]==4)
+                {PSC316ManualPending[k][j]=2;PSC316ManualTick[k][j]=Systick_1ms;}
+                else PSC316ManualPending[k][j]=0;
+            }
+        }
+    }
+    for(k=0;k<4;k++)for(c=0;c<2;c++)
+    {
+        command=PSC316ManualPending[k][c];
+        if(command && (Systick_1ms-PSC316ManualTick[k][c]>=10000U ||
+           !PSC316ManualAllowed(k+1,c,command) ||
+           (command==2 && UnitReadStatus[k+1].CompStatus[c]!=4)))
+            PSC316ManualPending[k][c]=0;
+    }
+}
